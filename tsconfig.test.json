{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["tests/**/*", "src/renderer/src/env.d.ts"]
}
